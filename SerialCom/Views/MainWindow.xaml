<Window x:Class="SerialCom.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:models="clr-namespace:SerialCom.Models"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="串口通信平台 (WPF + Prism) — RS-232 / RS-485"
        Height="760" Width="1040"
        MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,12,2"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1) 配置区 -->
        <GroupBox Grid.Row="0" Header="串口配置" Margin="8,8,8,4" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="模式" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ModeOptions}"
                                  SelectedItem="{Binding SelectedMode}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="端口" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  Style="{StaticResource InputStyle}"/>
                        <Button Content="刷新" Padding="8,2"
                                Command="{Binding RefreshPortsCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="波特率" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding BaudRates}"
                                  SelectedItem="{Binding SelectedBaudRate}"
                                  IsEditable="True"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="数据位" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding DataBitsOptions}"
                                  SelectedItem="{Binding SelectedDataBits}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="校验" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ParityOptions}"
                                  SelectedItem="{Binding SelectedParity}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="停止位" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StopBitsOptions}"
                                  SelectedItem="{Binding SelectedStopBits}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"
                                Visibility="{Binding CanEditHandshake, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="握手" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding HandshakeOptions}"
                                  SelectedItem="{Binding SelectedHandshake}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"
                                Visibility="{Binding IsRs485, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="TX 时 RTS 高电平" Style="{StaticResource LabelStyle}"/>
                        <CheckBox IsChecked="{Binding RtsHighWhenTransmitting}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="编码" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding EncodingOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Display"
                                  SelectedValue="{Binding SelectedEncoding}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- 周期发送区 -->
                <Border Grid.Row="2" Background="#FFF7F7F7" CornerRadius="4" Padding="8,4" Margin="0,4,0,0">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="周期发送" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox IsChecked="{Binding AutoSendEnabled}"
                                  Content="启用"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"/>
                        <TextBlock Text="间隔(ms)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding AutoSendIntervalMs}" Width="90" VerticalContentAlignment="Center"
                                 Margin="0,0,16,4"/>
                        <TextBlock Text="内容" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding AutoSendText}" Width="260" VerticalContentAlignment="Center"
                                 Margin="0,0,16,4"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="计数："/>
                            <Run Text="{Binding AutoSendCounter, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 2) 日志区 -->
        <GroupBox Grid.Row="1" Header="通信日志" Margin="8,4" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,4,4,2">
                    <CheckBox Content="自动滚动" IsChecked="{Binding AutoScrollLog}"
                              VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                    <CheckBox Content="显示发送换行符" IsChecked="{Binding AppendNewLineOnSend}"
                              VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,16,0" Checked="CheckBox_Checked"/>
                    <TextBlock VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,16,0">
                        <Run Text="日志上限"/>
                        <Run Text="："/>
                    </TextBlock>
                    <TextBox Text="{Binding LogMaxLines}" Width="80" VerticalContentAlignment="Center"
                             DockPanel.Dock="Left" Margin="0,0,16,0"/>
                    <Button Content="清空日志" DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Command="{Binding ClearLogCommand}"
                            Padding="10,2" Margin="4,0,0,0"/>
                    <Button Content="导出日志(.txt)" DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Command="{Binding ExportLogCommand}"
                            Padding="10,2"/>
                </DockPanel>

                <ListBox x:Name="LogList" Grid.Row="1" Margin="2"
                         ItemsSource="{Binding Log}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding DirectionBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- 3) 发送区 -->
        <GroupBox Grid.Row="2" Header="发送数据" Margin="8,4" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="格式" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding FormatOptions}"
                                  SelectedItem="{Binding SelectedFormat}"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Button Content="发送" DockPanel.Dock="Right"
                            Style="{StaticResource BtnStyle}"
                            Command="{Binding SendCommand}"/>
                    <TextBox Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="13"
                             MinHeight="80" MaxHeight="140"
                             Margin="0,0,8,0"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- 4) 状态栏 -->
        <Border Grid.Row="3" Background="#FFF0F0F0" Padding="8,4">
            <DockPanel>
                <Button Content="打开端口" DockPanel.Dock="Left"
                        Style="{StaticResource BtnStyle}"
                        Command="{Binding OpenPortCommand}"/>
                <Button Content="关闭端口" DockPanel.Dock="Left"
                        Style="{StaticResource BtnStyle}"
                        Command="{Binding ClosePortCommand}"/>

                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Run Text="状态："/>
                    <Run>
                        <Run.Style>
                            <Style TargetType="Run">
                                <Setter Property="Text" Value="已断开"/>
                                <Setter Property="Foreground" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="Text" Value="已连接"/>
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                </TextBlock>

                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="TX：" FontWeight="SemiBold" Foreground="DodgerBlue"/>
                    <Run Text="{Binding TxCount, Mode=OneWay}"/>
                    <Run Text=" 字节   RX：" FontWeight="SemiBold" Foreground="SeaGreen"/>
                    <Run Text="{Binding RxCount, Mode=OneWay}"/>
                    <Run Text=" 字节"/>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
